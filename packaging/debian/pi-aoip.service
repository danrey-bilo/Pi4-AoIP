[Unit]
Description=PiAoIP 2.1 - Raspberry Pi 4 RT audio transport
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=piaoip
Group=piaoip
StateDirectory=piaoip
StateDirectoryMode=0750
WorkingDirectory=/var/lib/piaoip
Environment=PIAOIP_PROFILE=/var/lib/piaoip/profile.txt
EnvironmentFile=/etc/piaoip/peer.conf
ExecStart=/usr/lib/piaoip/aoip_peer_rpi4 pi ${PIAOIP_PEER} 50020 50021 64 192000 32 5 0 64
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
CPUAffinity=0 1
LimitRTPRIO=80
LimitMEMLOCK=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/piaoip

[Install]
WantedBy=multi-user.target
