#!/bin/sh
set -eu
case "${1:-}" in
  remove)
    deb-systemd-helper mask pi-aoip.service >/dev/null || true
    ;;
  purge)
    deb-systemd-helper purge pi-aoip.service >/dev/null || true
    deb-systemd-helper unmask pi-aoip.service >/dev/null || true
    # User profiles and migration backups remain in /var/lib/piaoip intentionally.
    ;;
  abort-install|abort-upgrade)
    rm -f -- /var/lib/piaoip-package/start-after-install
    backup=/var/lib/piaoip/legacy-2.1
    if [ -f "$backup/migration-pending" ] && [ -f "$backup/pi-aoip.service" ] &&
       [ ! -e /etc/systemd/system/pi-aoip.service ]; then
      cp -p "$backup/pi-aoip.service" /etc/systemd/system/pi-aoip.service
      rm -- "$backup/migration-pending"
      if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl start pi-aoip.service || true
      fi
    fi
    ;;
esac
if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
